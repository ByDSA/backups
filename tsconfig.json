{
  "compileOnSave": true,
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "outDir": "./build",
    "sourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "importHelpers": true,
    "target": "es2015",
    "noImplicitAny": true,
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2022", "dom"],
    "types": ["node", "jest"],
    "isolatedModules": true,
    "rootDir": ".",
    "paths": {
      "#src/*": ["./src/*"],
      "#tests/*": ["./tests/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
