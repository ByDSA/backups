{
  "name": "backups",
  "version": "1.3.0",
  "description": "",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "clean": "pnpm test:coverage:clean; pnpm build:clean;",
    "prepare": "husky",
    "prebuild": "pnpm build:clean && pnpm rebuild && pnpm test",
    "build": "pnpm build:clean && pnpm build:raw",
    "build:raw": "tsc -p tsconfig-build.json && cp ./package.json build/",
    "build:clean": "rm -rf build",
    "bin:install": "pnpm build && BIN_OUT=/bin/backup; sudo rm -f \"$BIN_OUT\" && sudo ln -s \"$(pwd)/build/src/bin.js\" \"$BIN_OUT\" && sudo chmod +x \"$BIN_OUT\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --maxWorkers=1",
    "test:watch": "pnpm run test --watch",
    "test:coverage": "pnpm run test --coverage",
    "test:coverage:clean": "rm -rf coverage",
    "docs": "pnpm lint:fix && pnpm docs:clean && typedoc",
    "postdocs": ".scripts/docs-footer.sh",
    "docs:clean": ".scripts/docs-clean.sh",
    "docs:push": ".scripts/docs-push.sh",
    "lint:eslint": "eslint **/*.{ts,js,tsx,jsx}",
    "lint:prettier": "prettier **/*.{json,jsonc,scss,yml}",
    "lint:fix": "pnpm run lint:prettier --write && pnpm run lint:eslint --fix",
    "version:release": "standard-version",
    "readme": "pnpm readme:clean && npx readme-md-generator -p .readme/template.md -y",
    "readme:clean": "rm -f README.md"
  },
  "keywords": [],
  "author": "Daniel Sales Álvarez <danisales.es@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@types/sha256-file": "1.0.1",
    "@types/yargs": "17.0.24",
    "@typescript-eslint/eslint-plugin": "5.59.5",
    "@typescript-eslint/parser": "5.59.5",
    "eslint": "8.40.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jest": "27.2.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "standard-version": "9.5.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "type": "module",
  "dependencies": {
    "chalk": "6.0.0",
    "deasync": "0.1.31",
    "sha256-file": "1.0.0",
    "synchronized-promise": "0.3.1",
    "utimes": "5.2.1",
    "yargs": "18.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
